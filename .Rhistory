suppressPackageStartupMessages(library(optparse))
install.packages("optparse")
install.packages("rhdf5")
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("rhdf5")
library(optparse)
library(rhdf5)
option_list <- list(
make_option(c("-f", "--file"), type = "character", help = "Path to the exported HDF5 file")
)
parser <- OptionParser(option_list = option_list)
args <- parse_args(parser, positional_arguments = TRUE)
if (length(args$args) == 0 && is.null(args$options$file)) {
print_help(parser)
stop("Specify an HDF5 file with --file or as a positional argument", call. = FALSE)
}
library(rhdf5)
h5_path <- commandArgs(trailingOnly = TRUE)[1]
if (is.na(h5_path) || identical(h5_path, "")) {
h5_path <- file.choose(new = FALSE)
}
h5 <- H5Fopen(h5_path)
on.exit(H5Fclose(h5))
cat("Cardinal export summary\n========================\n")
cat(sprintf("format:          %s\n", h5$attr$format))
library(rhdf5)
h5_path <- commandArgs(trailingOnly = TRUE)[1]
if (is.na(h5_path) || identical(h5_path, "")) {
h5_path <- file.choose(new = FALSE)
}
h5 <- H5Fopen(h5_path)
on.exit(H5Fclose(h5))
file_attrs <- h5readAttributes(h5, "/")
attr_value <- function(name) {
value <- file_attrs[[name]]
if (is.null(value) || length(value) == 0) "<missing>" else value
}
cat("Cardinal export summary\n========================\n")
cat(sprintf("format:          %s\n", attr_value("format")))
cat(sprintf(
"creator:         %s (%s)\n",
attr_value("creator"),
attr_value("creator_version")
))
cat(sprintf("image_type:      %s\n", attr_value("image_type")))
intensity <- h5read(h5_path, "spectraData/intensity")
cat(sprintf("n_features:      %d\n", nrow(intensity)))
cat(sprintf("n_pixels:        %d\n", ncol(intensity)))
cat("\nIntensity matrix\n")
cat(sprintf("  shape: %dx%d\n", nrow(intensity), ncol(intensity)))
cat(sprintf("  dtype: %s\n", typeof(intensity)))
cat(sprintf("  sample range: [%.4g, %.4g]\n", min(intensity, na.rm = TRUE), max(intensity, na.rm = TRUE)))
print_columns <- function(group) {
columns <- h5readAttributes(h5_path, group)$columns
if (is.null(columns)) {
cat("  <no columns metadata>\n")
return()
}
for (column in columns) {
data <- h5read(h5_path, file.path(group, column))
preview <- if (length(data) > 0) data[[1]] else "<empty>"
cat(sprintf("  %s: length=%d, dtype=%s, first=%s\n", column, length(data), typeof(data), preview))
}
}
cat("\nPixel data columns:\n")
print_columns("pixelData")
cat("\nFeature data columns:\n")
print_columns("featureData")
samples <- h5ls(h5_path, recursive = FALSE)
samples_group <- subset(samples, name == "samples")
if (nrow(samples_group) == 1) {
sample_entries <- h5ls(h5_path, datasetinfo = FALSE, recursive = FALSE, group = "samples")
cat("\nSamples:\n")
for (i in seq_len(nrow(sample_entries))) {
sample_name <- sample_entries$name[i]
attrs <- h5readAttributes(h5_path, file.path("samples", sample_name))
cat(sprintf(
"  %s: id=%s, size=%sx%s\n",
sample_name,
attrs$sample_id,
attrs$height_px,
attrs$width_px
))
}
}
cat("\nDone.\n")
